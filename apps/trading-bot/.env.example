# 백엔드 실행 시 참조할 KIS 자격증명 예시.
# 실제 값은 절대 커밋하지 마세요. 로컬 .env 로 복사해서 사용합니다.

# 실전=true / 모의=false
KIS_LIVE=false

# https://apiportal.koreainvestment.com 에서 발급받은 앱키/시크릿
KIS_APP_KEY=
KIS_APP_SECRET=

# 계좌번호 앞 8자리 (CANO), 뒤 2자리 (ACNT_PRDT_CD)
KIS_CANO=
KIS_ACNT_PRDT_CD=01

# 실제 주문 API 호출을 허용할지 여부. 안전을 위해 기본값은 false.
TRADING_ORDER_ENABLED=false

# Spring 프로필: mock | live
SPRING_PROFILES_ACTIVE=mock # live

# --- 사전 안전장치 (application.yml 기본값 override) -----------------
# 정규장 시간에만 주문 허용 (평일 09:00~15:20 KST)
TRADING_MARKET_HOURS_ONLY=true
TRADING_OPEN_TIME=09:00
TRADING_CLOSE_TIME=15:20
# 허용 종목 화이트리스트. 콤마 구분. 예: 005930,000660
TRADING_ALLOWED_STOCK_CODES=005930
# 단건 주문 최대 수량
TRADING_MAX_QTY=1
# 하루 총 주문금액 상한(원). 수량 × (지정가 or 현재가) 누적.
TRADING_MAX_DAILY_NOTIONAL=50000

# --- 자동 매매 봇 ------------------------------------------------
# true 이면 스케줄러가 시그널 발생 시 실제 주문을 시도합니다. false 이면 시그널만 계산.
BOT_ENABLED=false
# 결정 주기 (KST). 평일 정규장 매 1분 (guard 가 open/close 시간 재차 필터).
BOT_CRON="0 * 9-15 * * MON-FRI"
# STATIC 모드일 때만 사용. VOLUME_RANK 모드에선 무시.
# 저가 대형주 초기 시드. GET /api/bot/candidates/analyze 로 주간 재큐레이션 가능.
BOT_CANDIDATES=005930,035720,055550,086790,316140,105560,042660,010140,006800,015760
# FIXED 사이징일 때 단건 수량. ALL_IN 모드에선 무시.
BOT_QTY=1

# SMA (분봉 기준) 파라미터
BOT_SMA_SHORT=5
BOT_SMA_LONG=20

# RSI 파라미터 (표준 14).
BOT_RSI_PERIOD=14
BOT_RSI_BUY_MAX=70
BOT_RSI_SELL_MIN=80

# 손절/익절 (%). 진입가 대비 현재가 손익률 기준. 0 이면 비활성.
BOT_STOP_LOSS_PCT=3.0
BOT_TAKE_PROFIT_PCT=5.0

# 후보 발굴 방식. STATIC / VOLUME_RANK / TECHNICAL_ANALYSIS (권장).
BOT_DISCOVERY_SOURCE=TECHNICAL_ANALYSIS
BOT_DISCOVERY_LIMIT=5
BOT_DISCOVERY_MIN_PRICE=2000
BOT_DISCOVERY_MAX_PRICE=100000
# TECHNICAL_ANALYSIS 캐시 유지 시간(초). 기본 10분.
BOT_TECHNICAL_CACHE_SECONDS=600

# 포지션 사이징. ALL_IN = KIS 예수금 × ratio 로 매수 수량 자동 산정. FIXED = BOT_QTY 고정.
BOT_SIZING_MODE=ALL_IN
BOT_ALL_IN_RATIO=1.0
